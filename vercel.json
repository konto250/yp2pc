{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "buildCommand": "python3 scripts/prepare_runtime.py",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "vendor/**",
      "excludeFiles": "{tests/**,scripts/**,.local/**,.venv/**,README.md}"
    }
  },
  "rewrites": [
    { "source": "/api/feeds", "destination": "/api/index" },
    { "source": "/feed/:id", "destination": "/api/index" },
    { "source": "/audio/:id", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://i.ytimg.com; media-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
      ]
    }
  ]
}
