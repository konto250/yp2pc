# iPadから接続できるPCの固定URL。末尾の / は不要です。
APP_BASE_URL=http://192.168.1.4:3000
# RSSに含めるプレイリスト先頭の件数（1～10）
MAX_EPISODES=10
# 保存容量の上限（バイト数）。既定5GiB。
MEDIA_MAX_BYTES=5368709120
# 保存先を変更する場合のみ指定します。
# MEDIA_DIR=D:/PodcastMedia
# 既存の実行ファイルを使う場合のみ指定します。
# YTDLP_BIN=C:/ffmpeg/bin/yt-dlp.exe
# FFmpegとFFprobeはPATHから検索します。個別指定する場合：
# FFMPEG_BIN=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_BIN=C:/ffmpeg/bin/ffprobe.exe
