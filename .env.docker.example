# LAN内ならLinux PCのアドレス。Cloudflare Tunnelでは固定HTTPS URL。
APP_BASE_URL=http://192.168.1.121:3001
# LAN内で試す場合はLinux PCのLANアドレス。
# ホスト上のcloudflaredから接続する場合は127.0.0.1。
BIND_ADDRESS=192.168.1.121
APP_PORT=3001
DATA_DIR=./data
# Linuxの id -u / id -g の値に合わせます。
APP_UID=1000
APP_GID=1000
MEDIA_MAX_BYTES=5368709120
MAX_EPISODES=10
