# Linux用。通常の docker compose コマンドでも両方の構成を読み込みます。
COMPOSE_FILE=compose.yaml:compose.cloud.yaml
# 購読URLを維持する場合は、移行元と同じ公開オリジンにします。
APP_BASE_URL=https://podcast.example.com
# 移行元の値を引き継ぎます。新規の場合は scripts/set_password.py で生成します。
ADMIN_PASSWORD_HASH=
DATA_DIR=./data
# 移行先の id -u / id -g に合わせます。
APP_UID=1000
APP_GID=1000
MEDIA_MAX_BYTES=5368709120
MAX_EPISODES=10
# Tunnelトークンは .local/cloudflared-token に保存します。このファイルには書きません。
